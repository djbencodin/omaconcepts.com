---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderMain from '../components/HeaderMain.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="OMA Concepts — We Build Apps People Actually Use"
  description="OMA Concepts is an independent software studio building consumer apps. Home of PhoodScout."
  ogUrl="https://omaconcepts.com"
>
  <div class="orbs">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
  </div>

  <HeaderMain />

  <main>
    <section class="hero">
      <div class="wrap">
        <div class="hero-inner">
          <div class="eyebrow"><span class="dot"></span> Independent Software Studio</div>
          <h1>We build apps<br>people <em>actually</em> use.</h1>
          <p class="hero-sub">OMA Concepts is a one-person software studio building consumer mobile apps. Named after Oma — because great things start personal.</p>
          <div class="hero-actions">
            <a href="/apps.html" class="btn btn-amber">Our Apps &rarr;</a>
            <a href="mailto:hello@omaconcepts.com" class="btn btn-ghost">Get in touch</a>
          </div>
        </div>
      </div>
    </section>

    <hr class="divider">

    <section id="about">
      <div class="wrap">
        <p class="section-label">About</p>
        <h2>Small team.<br>Real products.</h2>
        <p class="section-sub">No VC funding, no growth hacking, no dark patterns. Just software worth using.</p>
        <div class="about-grid">
          <div class="about-card">
            <div class="about-icon">&#127757;</div>
            <h3>Independent</h3>
            <p>No outside investors. No board. No one to answer to but users. That means we build what's useful, not what's fundable.</p>
          </div>
          <div class="about-card">
            <div class="about-icon">&#128241;</div>
            <h3>Mobile-first</h3>
            <p>Every app is designed for the device in your pocket first. iOS and Android, built with Capacitor so the web and native experience stay in sync.</p>
          </div>
          <div class="about-card">
            <div class="about-icon">&#128274;</div>
            <h3>Privacy-first</h3>
            <p>We don't sell your data. We don't run ads. We don't build engagement traps. Our Privacy Policy is written in plain language.</p>
          </div>
        </div>
      </div>
    </section>

    <hr class="divider">

    <section id="contact" style="padding-bottom:120px;">
      <div class="wrap">
        <div class="contact-strip">
          <div>
            <h2>Say hello.</h2>
            <p>Questions, feedback, press, or just want to chat about something we're building? We read every email.</p>
          </div>
          <a href="mailto:hello@omaconcepts.com" class="btn btn-amber">hello@omaconcepts.com &rarr;</a>
        </div>
      </div>
    </section>
  </main>

  <Footer
    links={[
      { href: '/phoodscout.html', label: 'PhoodScout' },
      { href: '/terms.html', label: 'Terms of Service' },
      { href: '/privacy.html', label: 'Privacy Policy' },
      { href: 'mailto:hello@omaconcepts.com', label: 'Contact' },
    ]}
  />
</BaseLayout>

<style>
  .orbs { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
  .orb { position: absolute; border-radius: 50%; filter: blur(80px); }
  .orb-1 {
    width: 700px; height: 700px;
    background: radial-gradient(circle, rgba(245,158,11,0.13) 0%, transparent 70%);
    top: -250px; right: -150px;
    animation: drift1 22s ease-in-out infinite;
  }
  .orb-2 {
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(99,102,241,0.10) 0%, transparent 70%);
    bottom: -150px; left: -150px;
    animation: drift2 28s ease-in-out infinite;
  }
  .orb-3 {
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(245,158,11,0.06) 0%, transparent 70%);
    top: 50%; left: 50%;
    transform: translate(-50%,-50%);
    animation: drift3 35s ease-in-out infinite;
  }
  @keyframes drift1 {
    0%,100% { transform: translate(0,0); }
    33% { transform: translate(-40px, 30px); }
    66% { transform: translate(30px,-20px); }
  }
  @keyframes drift2 {
    0%,100% { transform: translate(0,0); }
    33% { transform: translate(50px,-40px); }
    66% { transform: translate(-30px, 30px); }
  }
  @keyframes drift3 {
    0%,100% { transform: translate(-50%,-50%); }
    50% { transform: translate(-52%,-48%); }
  }

  .hero { min-height: 100vh; display: flex; align-items: center; padding-top: 64px; }
  .hero-inner { max-width: 780px; padding: 80px 0; }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(245,158,11,0.12);
    border: 1px solid rgba(245,158,11,0.2);
    border-radius: 100px; padding: 6px 14px;
    font-size: 12px; font-weight: 600; color: var(--amber);
    letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 32px;
  }
  .eyebrow .dot { width: 6px; height: 6px; background: var(--amber); border-radius: 50%; animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse {
    0%,100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }
  h1 {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(48px, 7vw, 88px);
    line-height: 1.05; letter-spacing: -1px; margin-bottom: 24px;
  }
  h1 em { font-style: italic; color: var(--amber); }
  .hero-sub { font-size: clamp(17px, 2vw, 20px); color: var(--muted); max-width: 540px; line-height: 1.65; margin-bottom: 44px; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 14px 26px; border-radius: 10px;
    font-family: 'Space Grotesk', sans-serif; font-size: 15px; font-weight: 600;
    cursor: pointer; text-decoration: none; transition: all 0.2s; border: none;
  }
  .btn-amber { background: var(--amber); color: #000; }
  .btn-amber:hover { background: #fbbf24; transform: translateY(-1px); box-shadow: 0 8px 30px rgba(245,158,11,0.3); }
  .btn-ghost { background: var(--surface); color: var(--text); border: 1px solid var(--border); }
  .btn-ghost:hover { background: var(--surface-hover); border-color: var(--border-hover); transform: translateY(-1px); }

  section { padding: 100px 0; position: relative; z-index: 1; }
  .section-label { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--amber); margin-bottom: 16px; }
  h2 { font-family: 'DM Serif Display', serif; font-size: clamp(32px, 4vw, 52px); line-height: 1.1; letter-spacing: -0.5px; margin-bottom: 16px; }
  .section-sub { font-size: 17px; color: var(--muted); max-width: 500px; line-height: 1.65; margin-bottom: 56px; }

  .about-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
  .about-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 32px; }
  .about-icon { font-size: 28px; margin-bottom: 16px; }
  .about-card h3 { font-family: 'DM Serif Display', serif; font-size: 22px; margin-bottom: 10px; }
  .about-card p { font-size: 14px; color: var(--muted); line-height: 1.65; }

  .contact-strip {
    background: var(--surface); border: 1px solid var(--border); border-radius: 16px;
    padding: 48px; display: flex; align-items: center; justify-content: space-between;
    gap: 32px; flex-wrap: wrap;
  }
  .contact-strip h2 { margin-bottom: 8px; }
  .contact-strip p { color: var(--muted); font-size: 16px; max-width: 420px; }

  @media (max-width: 768px) {
    .about-grid { grid-template-columns: 1fr; }
    .contact-strip { flex-direction: column; align-items: flex-start; }
  }
</style>
