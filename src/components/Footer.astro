---
interface Link { href: string; label: string }
interface Props {
  links: Link[];
  /** Marketing pages (index/apps) wrap the footer in the page's .wrap container.
      Detail/legal pages give the footer its own max-width + padding. */
  standalone?: boolean;
  logoHref?: string;
}
const { links, standalone = false, logoHref = '/' } = Astro.props;
---
{standalone ? (
  <footer class="standalone">
    <a href={logoHref} class="footer-logo">OMA <span>Concepts</span></a>
    <div class="footer-links">
      {links.map(l => <a href={l.href}>{l.label}</a>)}
    </div>
    <p class="footer-copy">&copy; 2026 OMA Concepts</p>
  </footer>
) : (
  <footer>
    <div class="wrap">
      <div class="footer-inner">
        <a href={logoHref} class="footer-logo">OMA <span>Concepts</span></a>
        <div class="footer-links">
          {links.map(l => <a href={l.href}>{l.label}</a>)}
        </div>
        <p class="footer-copy">&copy; 2026 OMA Concepts</p>
      </div>
    </div>
  </footer>
)}

<style>
  footer {
    position: relative; z-index: 1;
    border-top: 1px solid var(--border);
  }
  footer:not(.standalone) { padding: 40px 0; }
  footer.standalone {
    padding: 36px 24px;
    max-width: 1100px; margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 16px;
  }
  .footer-inner {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 16px;
  }
  .footer-logo {
    font-family: 'DM Serif Display', serif;
    font-size: 18px;
    color: var(--muted);
    text-decoration: none;
  }
  footer.standalone .footer-logo { font-size: 16px; }
  .footer-logo span { color: var(--amber); }
  .footer-links { display: flex; gap: 24px; flex-wrap: wrap; }
  footer.standalone .footer-links { gap: 20px; }
  .footer-links a {
    font-size: 13px;
    color: var(--faint);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-links a:hover { color: var(--text); }
  .footer-copy { font-size: 13px; color: var(--faint); }

  @media (max-width: 768px) {
    .footer-inner { flex-direction: column; align-items: flex-start; gap: 24px; }
  }
</style>
