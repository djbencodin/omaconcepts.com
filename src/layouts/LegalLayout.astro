---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';

interface TocItem { href: string; label: string }
interface Frontmatter {
  title: string;
  description: string;
  docTitle: string;
  effectiveDate: string;
  lastUpdated: string;
  siblingHref: string;
  siblingLabel: string;
  navTitle: string;
  toc: TocItem[];
}
// Astro passes markdown frontmatter to a `layout:` component under `Astro.props.frontmatter`.
const { title, description, docTitle, effectiveDate, lastUpdated, siblingHref, siblingLabel, navTitle, toc } =
  Astro.props.frontmatter as Frontmatter;
---
<BaseLayout title={title} description={description} grainOpacity={0.02}>
  <div class="orb"></div>

  <nav class="topnav">
    <div class="topnav-inner">
      <a href="/" class="back-link">&#8592; OMA Concepts</a>
      <span class="nav-title">{navTitle}</span>
      <span class="nav-sibling"><a href={siblingHref}>{siblingLabel} &rarr;</a></span>
    </div>
  </nav>

  <div class="page">
    <aside class="toc">
      <p class="toc-label">Contents</p>
      <ul class="toc-list">
        {toc.map(item => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </aside>

    <article class="content">
      <div class="doc-header">
        <div class="doc-eyebrow">Legal</div>
        <h1>{docTitle}</h1>
        <p class="doc-meta">Effective Date: <span>{effectiveDate}</span> &nbsp;&bull;&nbsp; Last Updated: <span>{lastUpdated}</span></p>
      </div>
      <slot />
    </article>
  </div>

  <Footer
    standalone
    links={[
      { href: '/', label: 'Home' },
      { href: '/phoodscout.html', label: 'PhoodScout' },
      { href: siblingHref, label: siblingLabel },
      { href: 'mailto:hello@omaconcepts.com', label: 'Contact' },
    ]}
  />

  <script>
    const sections = document.querySelectorAll('.section[id]');
    const links = document.querySelectorAll('.toc-list a');
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          links.forEach(l => l.classList.toggle('active', l.getAttribute('href') === '#' + e.target.id));
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    sections.forEach(s => obs.observe(s));
  </script>
</BaseLayout>

<style>
  body { line-height: 1.7; min-height: 100vh; }

  .orb {
    position: fixed; border-radius: 50%; filter: blur(100px);
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(99,102,241,0.10) 0%, transparent 70%);
    top: -150px; left: -150px; pointer-events: none; z-index: 0;
  }

  .topnav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(2,6,23,0.9); backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .topnav-inner {
    max-width: 1100px; margin: 0 auto; padding: 0 24px;
    display: flex; align-items: center; justify-content: space-between;
    height: 60px;
  }
  .back-link {
    display: inline-flex; align-items: center; gap: 8px;
    color: var(--muted); text-decoration: none;
    font-size: 14px; font-weight: 500; transition: color 0.2s;
  }
  .back-link:hover { color: var(--text); }
  .nav-title { font-size: 14px; color: var(--faint); font-weight: 500; }
  .nav-sibling a { font-size: 13px; color: var(--faint); text-decoration: none; transition: color 0.2s; }
  .nav-sibling a:hover { color: var(--amber); }

  .page {
    position: relative; z-index: 1;
    max-width: 1100px; margin: 0 auto;
    padding: 60px 24px 100px;
    display: grid; grid-template-columns: 220px 1fr;
    gap: 60px; align-items: start;
  }
  .toc { position: sticky; top: 80px; }
  .toc-label {
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--amber); margin-bottom: 16px;
  }
  .toc-list { list-style: none; display: flex; flex-direction: column; gap: 2px; }
  .toc-list a {
    display: block; font-size: 13px; color: var(--faint);
    text-decoration: none; padding: 5px 10px; border-radius: 6px;
    border-left: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
    line-height: 1.4;
  }
  .toc-list a:hover { color: var(--text); background: var(--surface); }
  .toc-list a:global(.active) { color: var(--amber); border-left-color: var(--amber); background: rgba(245,158,11,0.10); }

  .doc-header { margin-bottom: 52px; }
  .doc-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(245,158,11,0.10); border: 1px solid rgba(245,158,11,0.22);
    border-radius: 100px; padding: 5px 14px;
    font-size: 11px; font-weight: 700;
    color: var(--amber); letter-spacing: 0.1em;
    text-transform: uppercase; margin-bottom: 20px;
  }
  .doc-header :global(h1) {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(32px, 4vw, 52px);
    letter-spacing: -0.5px; line-height: 1.1; margin-bottom: 16px;
  }
  .doc-meta { font-size: 14px; color: var(--faint); }
  .doc-meta span { color: var(--muted); }

  @media (max-width: 768px) {
    .page { grid-template-columns: 1fr; gap: 32px; }
    .toc { display: none; }
  }
</style>

<style is:global>
  .notice {
    background: rgba(245,158,11,0.10); border: 1px solid rgba(245,158,11,0.22);
    border-radius: 12px; padding: 18px 22px;
    font-size: 14px; color: var(--muted); line-height: 1.6; margin-bottom: 48px;
  }
  .notice strong { color: var(--amber); }
  .highlight-box {
    background: rgba(99,102,241,0.08); border: 1px solid rgba(99,102,241,0.2);
    border-radius: 12px; padding: 18px 22px;
    font-size: 14px; color: var(--muted); margin-bottom: 14px;
  }
  .caps {
    font-size: 13px; font-weight: 600;
    color: var(--muted); line-height: 1.7;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px 22px;
    margin-bottom: 14px;
  }
  .section { margin-bottom: 52px; scroll-margin-top: 80px; }
  .section h2 {
    font-family: 'DM Serif Display', serif; font-size: 26px;
    letter-spacing: -0.3px; margin-bottom: 20px;
    padding-bottom: 12px; border-bottom: 1px solid var(--border);
    color: var(--text);
  }
  .section h3 { font-size: 16px; font-weight: 700; color: var(--text); margin: 24px 0 10px; }
  .section p { font-size: 15px; color: var(--muted); margin-bottom: 14px; line-height: 1.75; }
  .section p:last-child { margin-bottom: 0; }
  .section ul, .section ol { padding-left: 22px; margin-bottom: 14px; }
  .section li { font-size: 15px; color: var(--muted); margin-bottom: 8px; line-height: 1.7; }
  .section table { width: 100%; border-collapse: collapse; margin-bottom: 14px; font-size: 14px; }
  .section th {
    text-align: left; padding: 10px 14px; font-size: 12px;
    font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--faint); border-bottom: 1px solid var(--border);
  }
  .section td { padding: 12px 14px; color: var(--muted); border-bottom: 1px solid rgba(255,255,255,0.04); vertical-align: top; }
  .section tr:last-child td { border-bottom: none; }
  .content strong { color: var(--text); font-weight: 600; }
  .content a { color: var(--amber); text-decoration: none; }
  .content a:hover { text-decoration: underline; }
  .content > p:first-of-type { font-size: 15px; color: var(--muted); margin-bottom: 48px; }
</style>
